{
  "version": 1,
  "apps": [
    {
      "id": "directus",
      "name": "Directus",
      "description": "Headless CMS with an instant REST + GraphQL API over your data. Sign in with the admin email and generated password below.",
      "kind": "template",
      "logo": "directus",
      "category": "cms",
      "tags": [
        "cms",
        "headless",
        "api"
      ],
      "framework": "docker-compose",
      "services": [
        {
          "name": "directus",
          "image": "directus/directus:12.3.1",
          "ports": [],
          "exposed": true,
          "environment": {
            "DB_CLIENT": "sqlite3",
            "DB_FILENAME": "/directus/database/data.db",
            "PUBLIC_URL": "{{publicUrl:directus}}",
            "ADMIN_EMAIL": "admin@example.com",
            "SECRET": "{{config:SECRET}}",
            "ADMIN_PASSWORD": "{{config:ADMIN_PASSWORD}}"
          },
          "secretEnv": [
            "SECRET",
            "ADMIN_PASSWORD"
          ],
          "volumes": [
            "directus_database:/directus/database",
            "directus_uploads:/directus/uploads"
          ],
          "restart": "unless-stopped",
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "wget -q -O /dev/null http://127.0.0.1:8055/server/health || exit 1"
            ],
            "interval": "15s",
            "timeout": "5s",
            "retries": 8,
            "startPeriod": "30s"
          },
          "exposedPort": 8055
        }
      ],
      "configFields": [
        {
          "key": "SECRET",
          "service": "directus",
          "label": "Secret",
          "generate": "secret",
          "secret": true,
          "required": true
        },
        {
          "key": "ADMIN_PASSWORD",
          "service": "directus",
          "label": "Admin password",
          "generate": "secret",
          "secret": true,
          "required": true
        }
      ],
      "endpoints": [
        {
          "service": "directus",
          "port": 8055,
          "label": "Directus 8055",
          "kind": "http",
          "defaultMode": "domain"
        }
      ],
      "connection": {
        "title": "Connect to Directus",
        "outputs": [
          {
            "id": "url",
            "label": "URL",
            "source": "publicUrl:directus",
            "kind": "url",
            "recommended": true
          },
          {
            "id": "secret",
            "label": "Secret",
            "source": "env:directus:SECRET",
            "secret": true
          },
          {
            "id": "admin_password",
            "label": "Admin password",
            "source": "env:directus:ADMIN_PASSWORD",
            "secret": true
          }
        ]
      },
      "available": true,
      "updatedAt": "2026-09-14T05:51:09.627Z",
      "repository": "https://github.com/directus/directus"
    },
    {
      "id": "ghost",
      "name": "Ghost",
      "description": "Modern publishing platform for blogs, newsletters, and membership sites. Claim the owner account on your first visit.",
      "kind": "template",
      "logo": "ghost",
      "category": "cms",
      "tags": [
        "cms",
        "blog",
        "newsletter"
      ],
      "framework": "docker-compose",
      "services": [
        {
          "name": "ghost-db",
          "image": "mysql:8.0",
          "ports": [],
          "exposed": false,
          "environment": {
            "MYSQL_DATABASE": "ghost",
            "MYSQL_ROOT_PASSWORD": "{{config:MYSQL_ROOT_PASSWORD}}"
          },
          "secretEnv": [
            "MYSQL_ROOT_PASSWORD"
          ],
          "volumes": [
            "ghost_db:/var/lib/mysql"
          ],
          "restart": "unless-stopped"
        },
        {
          "name": "ghost",
          "image": "ghost:5-alpine",
          "ports": [],
          "exposed": true,
          "environment": {
            "NODE_ENV": "production",
            "url": "{{publicUrl:ghost}}",
            "database__client": "mysql",
            "database__connection__host": "ghost-db",
            "database__connection__user": "root",
            "database__connection__database": "ghost",
            "database__connection__password": "{{config:database__connection__password}}"
          },
          "secretEnv": [
            "database__connection__password"
          ],
          "volumes": [
            "ghost_content:/var/lib/ghost/content"
          ],
          "dependsOn": [
            "ghost-db"
          ],
          "restart": "unless-stopped",
          "exposedPort": 2368
        }
      ],
      "configFields": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "service": "ghost-db",
          "label": "Mysql root password",
          "generate": "secret",
          "secret": true,
          "required": true,
          "generateGroup": "MYSQL_ROOT_PASSWORD"
        },
        {
          "key": "database__connection__password",
          "service": "ghost",
          "label": "Database connection password",
          "generate": "secret",
          "secret": true,
          "required": true,
          "generateGroup": "MYSQL_ROOT_PASSWORD"
        }
      ],
      "endpoints": [
        {
          "service": "ghost",
          "port": 2368,
          "label": "Ghost 2368",
          "kind": "http",
          "defaultMode": "domain"
        }
      ],
      "connection": {
        "title": "Connect to Ghost",
        "outputs": [
          {
            "id": "url",
            "label": "URL",
            "source": "publicUrl:ghost",
            "kind": "url",
            "recommended": true
          },
          {
            "id": "mysql_root_password",
            "label": "Mysql root password",
            "source": "env:ghost-db:MYSQL_ROOT_PASSWORD",
            "secret": true
          },
          {
            "id": "database__connection__password",
            "label": "Database connection password",
            "source": "env:ghost:database__connection__password",
            "secret": true
          }
        ]
      },
      "available": true,
      "updatedAt": "2026-09-14T05:51:09.636Z"
    },
    {
      "id": "mautic",
      "name": "Mautic",
      "description": "Open-source marketing automation: landing pages, forms, email campaigns, contact tracking and drip workflows in one self-hosted app.",
      "kind": "template",
      "logo": "mautic",
      "category": "automation",
      "tags": [
        "marketing",
        "automation",
        "email",
        "crm"
      ],
      "framework": "docker-compose",
      "services": [
        {
          "name": "mysql",
          "image": "mysql:8.0",
          "ports": [],
          "exposed": false,
          "environment": {
            "MYSQL_ROOT_PASSWORD": "{{config:MYSQL_ROOT_PASSWORD}}",
            "MYSQL_DATABASE": "mautic",
            "MYSQL_USER": "mautic",
            "MYSQL_PASSWORD": "{{config:MAUTIC_DB_PASSWORD}}"
          },
          "secretEnv": [
            "MYSQL_ROOT_PASSWORD",
            "MYSQL_PASSWORD"
          ],
          "volumes": [
            "mysql_data:/var/lib/mysql"
          ],
          "restart": "unless-stopped",
          "healthcheck": {
            "test": [
              "CMD",
              "mysqladmin",
              "ping",
              "-h",
              "localhost"
            ],
            "interval": "10s",
            "timeout": "5s",
            "retries": 5
          },
          "command": "--default-authentication-plugin=mysql_native_password"
        },
        {
          "name": "mautic",
          "image": "mautic/mautic:5.2.11-apache",
          "ports": [],
          "exposed": true,
          "environment": {
            "DOCKER_MAUTIC_ROLE": "mautic_web",
            "DOCKER_MAUTIC_RUN_MIGRATIONS": "true",
            "MAUTIC_DB_HOST": "mysql",
            "MAUTIC_DB_PORT": "3306",
            "MAUTIC_DB_DATABASE": "mautic",
            "MAUTIC_DB_USER": "mautic",
            "MAUTIC_DB_PASSWORD": "{{config:MAUTIC_DB_PASSWORD}}",
            "MAUTIC_URL": "https://{{publicUrl:mautic}}",
            "MAUTIC_TRUSTED_PROXIES": "[\"0.0.0.0/0\"]",
            "MAUTIC_MESSENGER_DSN_EMAIL": "doctrine://default",
            "MAUTIC_MESSENGER_DSN_HIT": "doctrine://default",
            "PHP_INI_DATE_TIMEZONE": "UTC",
            "PHP_MEMORY_LIMIT": "512M"
          },
          "secretEnv": [
            "MAUTIC_DB_PASSWORD"
          ],
          "volumes": [
            "mautic_data:/var/www/html"
          ],
          "dependsOn": [
            "mysql"
          ],
          "restart": "unless-stopped",
          "exposedPort": 80
        },
        {
          "name": "mautic-cron",
          "image": "mautic/mautic:5.2.11-apache",
          "ports": [],
          "exposed": false,
          "environment": {
            "DOCKER_MAUTIC_ROLE": "mautic_cron",
            "MAUTIC_DB_HOST": "mysql",
            "MAUTIC_DB_PORT": "3306",
            "MAUTIC_DB_DATABASE": "mautic",
            "MAUTIC_DB_USER": "mautic",
            "MAUTIC_DB_PASSWORD": "{{config:MAUTIC_DB_PASSWORD}}",
            "MAUTIC_URL": "https://{{publicUrl:mautic}}",
            "PHP_INI_DATE_TIMEZONE": "UTC"
          },
          "secretEnv": [
            "MAUTIC_DB_PASSWORD"
          ],
          "volumes": [
            "mautic_data:/var/www/html"
          ],
          "dependsOn": [
            "mautic"
          ],
          "restart": "unless-stopped"
        },
        {
          "name": "mautic-worker",
          "image": "mautic/mautic:5.2.11-apache",
          "ports": [],
          "exposed": false,
          "environment": {
            "DOCKER_MAUTIC_ROLE": "mautic_worker",
            "DOCKER_MAUTIC_WORKERS_CONSUME_EMAIL": "2",
            "DOCKER_MAUTIC_WORKERS_CONSUME_HIT": "2",
            "DOCKER_MAUTIC_WORKERS_CONSUME_FAILED": "2",
            "MAUTIC_DB_HOST": "mysql",
            "MAUTIC_DB_PORT": "3306",
            "MAUTIC_DB_DATABASE": "mautic",
            "MAUTIC_DB_USER": "mautic",
            "MAUTIC_DB_PASSWORD": "{{config:MAUTIC_DB_PASSWORD}}",
            "MAUTIC_URL": "https://{{publicUrl:mautic}}",
            "MAUTIC_MESSENGER_DSN_EMAIL": "doctrine://default",
            "MAUTIC_MESSENGER_DSN_HIT": "doctrine://default",
            "PHP_INI_DATE_TIMEZONE": "UTC"
          },
          "secretEnv": [
            "MAUTIC_DB_PASSWORD"
          ],
          "volumes": [
            "mautic_data:/var/www/html"
          ],
          "dependsOn": [
            "mautic"
          ],
          "restart": "unless-stopped"
        },
        {
          "name": "phpmyadmin",
          "image": "phpmyadmin/phpmyadmin:5.2.3",
          "ports": [],
          "exposed": true,
          "environment": {
            "PMA_HOST": "mysql",
            "PMA_PORT": "3306",
            "UPLOAD_LIMIT": "64M"
          },
          "dependsOn": [
            "mysql"
          ],
          "restart": "unless-stopped",
          "exposedPort": 80
        }
      ],
      "configFields": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "service": "mysql",
          "label": "Mysql root password",
          "generate": "secret",
          "secret": true,
          "required": true
        },
        {
          "key": "MAUTIC_DB_PASSWORD",
          "service": "mautic",
          "label": "Mautic db password",
          "generate": "secret",
          "secret": true,
          "required": true
        }
      ],
      "endpoints": [
        {
          "service": "mautic",
          "port": 80,
          "label": "Mautic",
          "kind": "http",
          "defaultMode": "domain"
        },
        {
          "service": "phpmyadmin",
          "port": 80,
          "label": "Database manager",
          "kind": "http",
          "defaultMode": "domain"
        }
      ],
      "connection": {
        "title": "Connect to Mautic",
        "outputs": [
          {
            "id": "url_mautic_80",
            "label": "Mautic URL",
            "source": "publicUrl:mautic",
            "kind": "url",
            "recommended": true
          },
          {
            "id": "url_phpmyadmin_80",
            "label": "Database manager URL",
            "source": "publicUrl:phpmyadmin",
            "kind": "url",
            "recommended": true
          },
          {
            "id": "mysql_root_password",
            "label": "Mysql root password",
            "source": "env:mysql:MYSQL_ROOT_PASSWORD",
            "secret": true
          },
          {
            "id": "mautic_db_password",
            "label": "Mautic db password",
            "source": "env:mautic:MAUTIC_DB_PASSWORD",
            "secret": true
          }
        ]
      },
      "available": true,
      "updatedAt": "2026-09-14T05:51:09.642Z",
      "repository": "https://github.com/mautic/mautic"
    },
    {
      "id": "mindwire",
      "name": "MindWire",
      "description": "Run coding-agent runtimes behind a self-hosted control plane. MindWire keeps the runtime private and gives you one console to manage agents, credentials, and sessions.",
      "kind": "template",
      "logo": "mindwire",
      "category": "automation",
      "tags": [
        "ai",
        "agents",
        "coding",
        "control-plane"
      ],
      "framework": "docker-compose",
      "services": [
        {
          "name": "runtime",
          "image": "ghcr.io/oblien/mindwire-runtime:0.1.3",
          "ports": [],
          "exposed": false,
          "environment": {
            "ADDR": "0.0.0.0:8790",
            "AGENT_TYPE": "claude-code",
            "DAEMON_TOKEN": "{{config:MINDWIRE_RUNTIME_TOKEN}}",
            "MINDWIRE_RUNTIME_TOKEN": "{{config:MINDWIRE_RUNTIME_TOKEN}}"
          },
          "secretEnv": [
            "DAEMON_TOKEN",
            "MINDWIRE_RUNTIME_TOKEN"
          ],
          "volumes": [
            "mindwire_runtime:/home/node"
          ],
          "restart": "unless-stopped"
        },
        {
          "name": "console",
          "image": "ghcr.io/oblien/mindwire-console:0.1.3",
          "ports": [],
          "exposed": true,
          "environment": {
            "NODE_ENV": "production",
            "PORT": "8787",
            "BASE_URL": "{{publicUrl:console}}",
            "AUTH_DB_PATH": "/data/auth.db",
            "CONSOLE_MODE": "self-hosted",
            "CONSOLE_USERNAME": "{{config:CONSOLE_USERNAME}}",
            "CONSOLE_PASSWORD": "{{config:CONSOLE_PASSWORD}}",
            "AUTH_SECRET": "{{config:AUTH_SECRET}}",
            "SECRETS_ENCRYPTION_KEY": "{{config:SECRETS_ENCRYPTION_KEY}}",
            "ALLOW_LOCAL_RUNTIME": "true",
            "ALLOW_SSH_RUNTIME": "true",
            "ALLOW_DOCKER_RUNTIME": "true",
            "ALLOW_REMOTE_RUNTIME": "true",
            "DAEMON_URL": "http://runtime:8790",
            "MINDWIRE_RUNTIME_TOKEN": "{{config:MINDWIRE_RUNTIME_TOKEN}}",
            "SEED_DEFAULT_DAEMON": "true"
          },
          "secretEnv": [
            "CONSOLE_PASSWORD",
            "AUTH_SECRET",
            "SECRETS_ENCRYPTION_KEY",
            "MINDWIRE_RUNTIME_TOKEN"
          ],
          "volumes": [
            "mindwire_console:/data"
          ],
          "dependsOn": [
            "runtime"
          ],
          "restart": "unless-stopped",
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "node -e \"fetch('http://127.0.0.1:8787/api/ping').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\""
            ],
            "interval": "10s",
            "timeout": "5s",
            "retries": 12,
            "startPeriod": "20s"
          },
          "exposedPort": 8787
        }
      ],
      "configFields": [
        {
          "key": "CONSOLE_USERNAME",
          "service": "console",
          "label": "Console username",
          "type": "text",
          "default": "admin",
          "required": false
        },
        {
          "key": "CONSOLE_PASSWORD",
          "service": "console",
          "label": "Console password",
          "generate": "secret",
          "secret": true,
          "required": true
        },
        {
          "key": "AUTH_SECRET",
          "service": "console",
          "label": "Auth secret",
          "generate": "secret",
          "secret": true,
          "required": true
        },
        {
          "key": "SECRETS_ENCRYPTION_KEY",
          "service": "console",
          "label": "Secrets encryption key",
          "generate": "secret",
          "secret": true,
          "required": true
        },
        {
          "key": "MINDWIRE_RUNTIME_TOKEN",
          "service": "runtime",
          "label": "Mindwire runtime token",
          "generate": "secret",
          "secret": true,
          "required": true
        }
      ],
      "endpoints": [
        {
          "service": "console",
          "port": 8787,
          "label": "Console 8787",
          "kind": "http",
          "defaultMode": "domain"
        }
      ],
      "connection": {
        "title": "Connect to MindWire",
        "outputs": [
          {
            "id": "url",
            "label": "URL",
            "source": "publicUrl:console",
            "kind": "url",
            "recommended": true
          },
          {
            "id": "console_password",
            "label": "Console password",
            "source": "env:console:CONSOLE_PASSWORD",
            "secret": true
          },
          {
            "id": "auth_secret",
            "label": "Auth secret",
            "source": "env:console:AUTH_SECRET",
            "secret": true
          },
          {
            "id": "secrets_encryption_key",
            "label": "Secrets encryption key",
            "source": "env:console:SECRETS_ENCRYPTION_KEY",
            "secret": true
          },
          {
            "id": "mindwire_runtime_token",
            "label": "Mindwire runtime token",
            "source": "env:runtime:MINDWIRE_RUNTIME_TOKEN",
            "secret": true
          }
        ]
      },
      "available": true,
      "updatedAt": "2026-09-14T05:51:09.645Z",
      "repository": "https://github.com/oblien/mindwire"
    },
