    {
      "id": "umami",
      "name": "Umami",
      "description": "Privacy-friendly, cookie-free web analytics — a self-hosted alternative to Google Analytics. Add one script tag to your site and see traffic in a clean dashboard you own.",
      "kind": "template",
      "logo": "umami",
      "category": "analytics",
      "tags": [
        "analytics",
        "web-analytics",
        "privacy",
        "statistics"
      ],
      "framework": "docker-compose",
      "services": [
        {
          "name": "umami",
          "image": "ghcr.io/umami-software/umami:postgresql-v2.19.0",
          "ports": [],
          "exposed": true,
          "environment": {
            "DATABASE_TYPE": "postgresql",
            "DATABASE_URL": "postgresql://umami:{{config:POSTGRES_PASSWORD}}@umami-db:5432/umami",
            "APP_SECRET": "{{config:APP_SECRET}}"
          },
          "secretEnv": [
            "DATABASE_URL",
            "APP_SECRET"
          ],
          "dependsOn": [
            "umami-db"
          ],
          "restart": "unless-stopped",
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "wget -q -O - http://127.0.0.1:3000/api/heartbeat 2>&1 | grep -q ok"
            ],
            "interval": "10s",
            "timeout": "5s",
            "retries": 10,
            "startPeriod": "30s"
          },
          "exposedPort": 3000
        },
        {
          "name": "umami-db",
          "image": "postgres:16-alpine",
          "ports": [],
          "exposed": false,
          "environment": {
            "POSTGRES_DB": "umami",
            "POSTGRES_USER": "umami",
            "POSTGRES_PASSWORD": "{{config:POSTGRES_PASSWORD}}"
          },
          "secretEnv": [
            "POSTGRES_PASSWORD"
          ],
          "volumes": [
            "umami_db:/var/lib/postgresql/data"
          ],
          "restart": "unless-stopped",
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "pg_isready -U umami -d umami"
            ],
            "interval": "10s",
            "timeout": "5s",
            "retries": 5,
            "startPeriod": "10s"
          }
        }
      ],
      "configFields": [
        {
          "key": "POSTGRES_PASSWORD",
          "service": "umami-db",
          "label": "Postgres password",
          "generate": "secret",
          "secret": true,
          "required": true
        },
        {
          "key": "APP_SECRET",
          "service": "umami",
          "label": "App secret",
          "generate": "secret",
          "secret": true,
          "required": true
        }
      ],
      "endpoints": [
        {
          "service": "umami",
          "port": 3000,
          "label": "Umami 3000",
          "kind": "http",
          "defaultMode": "domain"
        },
        {
          "service": "umami-db",
          "port": 5432,
          "label": "Umami db 5432",
          "kind": "tcp",
          "defaultMode": "publish"
        }
      ],
      "connection": {
        "title": "Connect to Umami",
        "outputs": [
          {
            "id": "url",
            "label": "Umami 3000 URL",
            "source": "publicUrl:umami",
            "kind": "url",
            "recommended": true
          },
          {
            "id": "postgres_password",
            "label": "Postgres password",
            "source": "env:umami-db:POSTGRES_PASSWORD",
